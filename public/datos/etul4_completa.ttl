# -----------------------------------------------------------------------------
# 5. Clases definidas: el razonador (HermiT, Pellet) clasifica los individuos automáticamente
# -----------------------------------------------------------------------------
etul:UnidadOmnibus a owl:Class ;
    rdfs:label "Unidad ómnibus"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Vehiculo [ a owl:Restriction ; owl:onProperty etul:categoria ; owl:hasValue etul:Omnibus ] ) ] .

etul:UnidadMicrobus a owl:Class ;
    rdfs:label "Unidad microbús"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Vehiculo [ a owl:Restriction ; owl:onProperty etul:categoria ; owl:hasValue etul:Microbus ] ) ] .

etul:UnidadCoaster a owl:Class ;
    rdfs:label "Unidad coaster"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Vehiculo [ a owl:Restriction ; owl:onProperty etul:categoria ; owl:hasValue etul:Coaster ] ) ] .

etul:UnidadApoyo a owl:Class ;
    rdfs:label "Unidad de apoyo"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Vehiculo [ a owl:Restriction ; owl:onProperty etul:categoria ; owl:hasValue etul:VehiculoApoyo ] ) ] .

etul:UnidadGNV a owl:Class ;
    rdfs:label "Unidad a gas natural"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Vehiculo [ a owl:Restriction ; owl:onProperty etul:combustible ; owl:someValuesFrom [ a owl:Class ; owl:oneOf ( etul:GNV etul:Dual ) ] ] ) ] .

etul:VehiculoDisponible a owl:Class ;
    rdfs:label "Vehículo disponible"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Vehiculo [ a owl:Restriction ; owl:onProperty etul:estadoActual ; owl:hasValue etul:Operativo ] ) ] .

etul:VehiculoNoDisponible a owl:Class ;
    rdfs:label "Vehículo no disponible"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Vehiculo [ a owl:Restriction ; owl:onProperty etul:estadoActual ; owl:someValuesFrom [ a owl:Class ; owl:oneOf ( etul:EnTaller etul:EsperandoRepuesto etul:FueraDeServicio etul:DocumentoVencido ) ] ] ) ] .

etul:OrdenPreventiva a owl:Class ;
    rdfs:label "Orden preventiva"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:OrdenTrabajo [ a owl:Restriction ; owl:onProperty etul:tipoMantenimiento ; owl:hasValue etul:Preventivo ] ) ] .

etul:OrdenCorrectiva a owl:Class ;
    rdfs:label "Orden correctiva"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:OrdenTrabajo [ a owl:Restriction ; owl:onProperty etul:tipoMantenimiento ; owl:hasValue etul:Correctivo ] ) ] .

etul:OrdenAbierta a owl:Class ;
    rdfs:label "Orden abierta"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:OrdenTrabajo [ a owl:Restriction ; owl:onProperty etul:estadoOrden ; owl:someValuesFrom [ a owl:Class ; owl:oneOf ( etul:Programada etul:EnEjecucion etul:BloqueadaPorRepuesto ) ] ] ) ] .

etul:OrdenEnCurso a owl:Class ;
    rdfs:label "Orden en curso"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:OrdenTrabajo [ a owl:Restriction ; owl:onProperty etul:estadoOrden ; owl:someValuesFrom [ a owl:Class ; owl:oneOf ( etul:EnEjecucion etul:BloqueadaPorRepuesto ) ] ] ) ] .

etul:OrdenBloqueada a owl:Class ;
    rdfs:label "Orden bloqueada"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:OrdenTrabajo [ a owl:Restriction ; owl:onProperty etul:estadoOrden ; owl:hasValue etul:BloqueadaPorRepuesto ] ) ] .

etul:VehiculoConOrdenAbierta a owl:Class ;
    rdfs:label "Vehículo con orden abierta"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Vehiculo [ a owl:Restriction ; owl:onProperty etul:tieneOrden ; owl:someValuesFrom etul:OrdenAbierta ] ) ] .

etul:VehiculoConOrdenEnCurso a owl:Class ;
    rdfs:label "Vehículo con orden en curso"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Vehiculo [ a owl:Restriction ; owl:onProperty etul:tieneOrden ; owl:someValuesFrom etul:OrdenEnCurso ] ) ] .

etul:FallaCritica a owl:Class ;
    rdfs:label "Falla crítica"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Falla [ a owl:Restriction ; owl:onProperty etul:severidad ; owl:hasValue etul:SeveridadCritica ] ) ] .

etul:FallaEnOperacion a owl:Class ;
    rdfs:label "Falla en operación"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:Falla [ a owl:Restriction ; owl:onProperty etul:reportadaPorConductor ; owl:someValuesFrom etul:Conductor ] ) ] .

etul:RestriccionDura a owl:Class ;
    rdfs:label "Restricción dura"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:ReglaExperto [ a owl:Restriction ; owl:onProperty etul:tipoRegla ; owl:hasValue etul:ReglaDura ] ) ] .

etul:Preferencia a owl:Class ;
    rdfs:label "Preferencia"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:ReglaExperto [ a owl:Restriction ; owl:onProperty etul:tipoRegla ; owl:hasValue etul:ReglaPreferencia ] ) ] .

etul:CriterioPrioridad a owl:Class ;
    rdfs:label "Criterio de prioridad"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:ReglaExperto [ a owl:Restriction ; owl:onProperty etul:tipoRegla ; owl:hasValue etul:ReglaPrioridad ] ) ] .

etul:Heuristica a owl:Class ;
    rdfs:label "Heurística"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:ReglaExperto [ a owl:Restriction ; owl:onProperty etul:tipoRegla ; owl:hasValue etul:ReglaHeuristica ] ) ] .

etul:ReglaAprobada a owl:Class ;
    rdfs:label "Regla aprobada"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:ReglaExperto [ a owl:Restriction ; owl:onProperty etul:estadoValidacion ; owl:hasValue etul:Aprobada ] ) ] .

etul:FuenteDeConductor a owl:Class ;
    rdfs:label "Fuente de conductor"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:FuenteTextual [ a owl:Restriction ; owl:onProperty etul:tipoFuente ; owl:hasValue etul:ReporteConductor ] ) ] .

etul:FuenteDeChatbot a owl:Class ;
    rdfs:label "Fuente de sesión con el asistente"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:FuenteTextual [ a owl:Restriction ; owl:onProperty etul:tipoFuente ; owl:hasValue etul:SesionChatbot ] ) ] .

etul:ExtraccionPendiente a owl:Class ;
    rdfs:label "Extracción pendiente de revisión"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:ExtraccionLLM [ a owl:Restriction ; owl:onProperty etul:estadoExtraccion ; owl:hasValue etul:ExtPropuesta ] ) ] .

etul:ExtraccionIncorporada a owl:Class ;
    rdfs:label "Extracción incorporada al grafo"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:ExtraccionLLM [ a owl:Restriction ; owl:onProperty etul:estadoExtraccion ; owl:someValuesFrom [ a owl:Class ; owl:oneOf ( etul:ExtAceptada etul:ExtCorregida ) ] ] ) ] .

etul:ExtraccionRechazada a owl:Class ;
    rdfs:label "Extracción rechazada"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:ExtraccionLLM [ a owl:Restriction ; owl:onProperty etul:estadoExtraccion ; owl:hasValue etul:ExtRechazada ] ) ] .

etul:RespuestaFundamentada a owl:Class ;
    rdfs:label "Respuesta fundamentada"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:RespuestaGenerada [ a owl:Restriction ; owl:onProperty etul:fundamentadaEn ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

etul:RespuestaSinEvidencia a owl:Class ;
    rdfs:label "Respuesta sin evidencia"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:RespuestaGenerada [ a owl:Restriction ; owl:onProperty etul:fundamentadaEn ; owl:maxCardinality "0"^^xsd:nonNegativeInteger ] ) ] .

etul:RespuestaCorrecta a owl:Class ;
    rdfs:label "Respuesta correcta"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:RespuestaGenerada [ a owl:Restriction ; owl:onProperty etul:tieneEvaluacion ; owl:someValuesFrom etul:EvaluacionCorrecta ] ) ] .

etul:EvaluacionCorrecta a owl:Class ;
    rdfs:label "Evaluación correcta"@es ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( etul:EvaluacionRespuesta [ a owl:Restriction ; owl:onProperty etul:veredicto ; owl:hasValue etul:Correcta ] ) ] .


