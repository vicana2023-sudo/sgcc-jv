# =============================================================================
# Ontología de mantenimiento y programación de flota — ETUL 4 S.A.
# Empresa de transporte urbano de Lima. Rutas 1100-P, 1098-L, 1054 y 1488-C.
# Versión 0.2.0. Incluye el módulo de trazabilidad del ciclo con modelos de lenguaje.
# Cambie el IRI base http://example.org/tesis/etul4 por el de su institución antes de publicar.
# =============================================================================
@prefix etul: <http://example.org/tesis/etul4#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/tesis/etul4> a owl:Ontology ;
    dcterms:title "Ontología de mantenimiento y programación de flota de transporte urbano"@es ;
    dcterms:description "Modela la flota de buses, las rutas y su cobertura, el plan y la ejecución del mantenimiento, los documentos con vigencia, el conocimiento del programador y la trazabilidad de los hechos extraídos por modelos de lenguaje."@es ;
    dcterms:created "2026-09-11"^^xsd:date ;
    owl:versionInfo "0.2.0" .

# -----------------------------------------------------------------------------
# 1. Clases núcleo
# -----------------------------------------------------------------------------
etul:Vehiculo a owl:Class ;
    rdfs:label "Vehículo"@es ;
    rdfs:comment "Unidad de la flota de transporte urbano sujeta a mantenimiento y programación."@es .

etul:Ruta a owl:Class ;
    rdfs:label "Ruta"@es ;
    rdfs:comment "Ruta autorizada que opera la empresa, con su recorrido, longitud y tiempo de ciclo."@es .

etul:AsignacionRuta a owl:Class ;
    rdfs:label "Asignación de ruta"@es ;
    rdfs:comment "Asignación de un vehículo y un conductor a una ruta en una fecha y turno."@es .

etul:DocumentoVehicular a owl:Class ;
    rdfs:label "Documento vehicular"@es ;
    rdfs:comment "Documento con vigencia que habilita a la unidad a circular (SOAT, revisión técnica, autorización)."@es .

etul:Lectura a owl:Class ;
    rdfs:label "Lectura"@es ;
    rdfs:comment "Medición de uso de un vehículo (odómetro) en una fecha."@es .

etul:RegistroEstado a owl:Class ;
    rdfs:label "Registro de estado"@es ;
    rdfs:comment "Periodo en que un vehículo permaneció en un estado operativo; base del cálculo de disponibilidad."@es .

etul:Persona a owl:Class ;
    rdfs:label "Persona"@es ;
    rdfs:comment "Persona que participa en la operación, el mantenimiento o la captura de conocimiento."@es .

etul:Tecnico a owl:Class ;
    rdfs:label "Técnico"@es ;
    rdfs:comment "Persona que ejecuta trabajos de mantenimiento."@es ;
    rdfs:subClassOf etul:Persona .

etul:Conductor a owl:Class ;
    rdfs:label "Conductor"@es ;
    rdfs:comment "Persona que opera un vehículo en ruta y reporta incidencias."@es ;
    rdfs:subClassOf etul:Persona .

etul:Experto a owl:Class ;
    rdfs:label "Experto"@es ;
    rdfs:comment "Persona cuyo conocimiento se captura como reglas (jefe de mantenimiento, programador, etc.)."@es ;
    rdfs:subClassOf etul:Persona .

etul:Taller a owl:Class ;
    rdfs:label "Taller"@es ;
    rdfs:comment "Instalación propia o externa donde se ejecutan mantenimientos."@es .

etul:Bahia a owl:Class ;
    rdfs:label "Bahía"@es ;
    rdfs:comment "Espacio de trabajo del taller (bahía, fosa o elevador) con capacidad limitada."@es .

etul:Repuesto a owl:Class ;
    rdfs:label "Repuesto"@es ;
    rdfs:comment "Artículo de inventario utilizado en mantenimientos."@es .

etul:PlanMantenimiento a owl:Class ;
    rdfs:label "Plan de mantenimiento"@es ;
    rdfs:comment "Conjunto de tareas programadas que aplica a una o más categorías de vehículo."@es .

etul:TareaProgramada a owl:Class ;
    rdfs:label "Tarea programada"@es ;
    rdfs:comment "Actividad del plan con su intervalo por kilómetros o días."@es .

etul:OrdenTrabajo a owl:Class ;
    rdfs:label "Orden de trabajo"@es ;
    rdfs:comment "Trabajo de mantenimiento programado o ejecutado sobre un vehículo."@es .

etul:ConsumoRepuesto a owl:Class ;
    rdfs:label "Consumo de repuesto"@es ;
    rdfs:comment "Relación n-aria entre una orden de trabajo, un repuesto y la cantidad requerida."@es .

etul:Falla a owl:Class ;
    rdfs:label "Falla"@es ;
    rdfs:comment "Evento de avería reportado sobre un componente de un vehículo."@es .

etul:SesionEntrevista a owl:Class ;
    rdfs:label "Sesión de entrevista"@es ;
    rdfs:comment "Sesión de captura de conocimiento con uno o más expertos."@es .

etul:ReglaExperto a owl:Class ;
    rdfs:label "Regla del experto"@es ;
    rdfs:comment "Conocimiento explícito capturado del experto que orienta la programación."@es .

etul:AjusteCalendario a owl:Class ;
    rdfs:label "Ajuste de calendario"@es ;
    rdfs:comment "Cambio realizado por una persona sobre la programación propuesta, con su motivo."@es .

etul:ModeloLLM a owl:Class ;
    rdfs:label "Modelo de lenguaje"@es ;
    rdfs:comment "Modelo de lenguaje usado para extraer hechos o traducir preguntas a consultas."@es .

etul:FuenteTextual a owl:Class ;
    rdfs:label "Fuente textual"@es ;
    rdfs:comment "Documento o transcripción de la que se extraen hechos: reporte de conductor, parte diario, entrevista."@es .

etul:ExtraccionLLM a owl:Class ;
    rdfs:label "Extracción del modelo"@es ;
    rdfs:comment "Hecho candidato propuesto por un modelo de lenguaje a partir de una fuente, con su confianza y su estado de revisión."@es .

etul:ConsultaNL a owl:Class ;
    rdfs:label "Consulta en lenguaje natural"@es ;
    rdfs:comment "Pregunta del usuario y la consulta SPARQL que el modelo generó para responderla."@es .

etul:RespuestaGenerada a owl:Class ;
    rdfs:label "Respuesta generada"@es ;
    rdfs:comment "Respuesta redactada por el modelo a partir de los resultados de la consulta, con los individuos que la fundamentan."@es .

etul:EvaluacionRespuesta a owl:Class ;
    rdfs:label "Evaluación de respuesta"@es ;
    rdfs:comment "Juicio humano sobre una respuesta generada; base de las métricas de la tesis."@es .

etul:Catalogo a owl:Class ;
    rdfs:label "Catálogo"@es ;
    rdfs:comment "Superclase de las listas controladas de valores (particiones de valor)."@es .

[] a owl:AllDisjointClasses ;
    owl:members ( etul:Vehiculo etul:Ruta etul:AsignacionRuta etul:DocumentoVehicular etul:Lectura etul:RegistroEstado etul:Persona etul:Taller etul:Bahia etul:Repuesto etul:PlanMantenimiento etul:TareaProgramada etul:OrdenTrabajo etul:ConsumoRepuesto etul:Falla etul:SesionEntrevista etul:ReglaExperto etul:AjusteCalendario etul:ModeloLLM etul:FuenteTextual etul:ExtraccionLLM etul:ConsultaNL etul:RespuestaGenerada etul:EvaluacionRespuesta etul:Catalogo ) .

# -----------------------------------------------------------------------------
# 2. Catálogos (particiones de valor) e individuos
# -----------------------------------------------------------------------------
etul:CategoriaVehiculo a owl:Class ;
    rdfs:label "Categoría de vehículo"@es ;
    rdfs:comment "Clasificación de la flota según tamaño y uso. Confirmar con la empresa antes de poblar."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:Omnibus etul:Microbus etul:Coaster etul:VehiculoApoyo ) ] .

etul:Omnibus a owl:NamedIndividual , etul:CategoriaVehiculo ;
    rdfs:label "Ómnibus urbano"@es .
etul:Microbus a owl:NamedIndividual , etul:CategoriaVehiculo ;
    rdfs:label "Microbús"@es .
etul:Coaster a owl:NamedIndividual , etul:CategoriaVehiculo ;
    rdfs:label "Coaster o minibús"@es .
etul:VehiculoApoyo a owl:NamedIndividual , etul:CategoriaVehiculo ;
    rdfs:label "Vehículo de apoyo y supervisión"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:Omnibus etul:Microbus etul:Coaster etul:VehiculoApoyo ) .

etul:TipoCombustible a owl:Class ;
    rdfs:label "Tipo de combustible"@es ;
    rdfs:comment "Fuente de energía de la unidad; condiciona tareas y certificados."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:Diesel etul:GNV etul:Dual etul:Electrico ) ] .

etul:Diesel a owl:NamedIndividual , etul:TipoCombustible ;
    rdfs:label "Diésel"@es .
etul:GNV a owl:NamedIndividual , etul:TipoCombustible ;
    rdfs:label "Gas natural vehicular"@es .
etul:Dual a owl:NamedIndividual , etul:TipoCombustible ;
    rdfs:label "Dual diésel y GNV"@es .
etul:Electrico a owl:NamedIndividual , etul:TipoCombustible ;
    rdfs:label "Eléctrico"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:Diesel etul:GNV etul:Dual etul:Electrico ) .

etul:TipoMantenimiento a owl:Class ;
    rdfs:label "Tipo de mantenimiento"@es ;
    rdfs:comment "Naturaleza del trabajo de mantenimiento."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:Preventivo etul:Correctivo etul:Predictivo etul:Inspeccion ) ] .

etul:Preventivo a owl:NamedIndividual , etul:TipoMantenimiento ;
    rdfs:label "Preventivo"@es .
etul:Correctivo a owl:NamedIndividual , etul:TipoMantenimiento ;
    rdfs:label "Correctivo"@es .
etul:Predictivo a owl:NamedIndividual , etul:TipoMantenimiento ;
    rdfs:label "Predictivo"@es .
etul:Inspeccion a owl:NamedIndividual , etul:TipoMantenimiento ;
    rdfs:label "Inspección"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:Preventivo etul:Correctivo etul:Predictivo etul:Inspeccion ) .

etul:TipoComponente a owl:Class ;
    rdfs:label "Tipo de componente"@es ;
    rdfs:comment "Sistema o componente del vehículo."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:Motor etul:Transmision etul:Frenos etul:SistemaNeumatico etul:Neumaticos etul:SistemaElectrico etul:Suspension etul:Direccion etul:PuertasServicio etul:Carroceria etul:SistemaCombustible etul:Climatizacion ) ] .

etul:Motor a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Motor"@es .
etul:Transmision a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Transmisión"@es .
etul:Frenos a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Frenos"@es .
etul:SistemaNeumatico a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Sistema neumático"@es .
etul:Neumaticos a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Neumáticos"@es .
etul:SistemaElectrico a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Sistema eléctrico"@es .
etul:Suspension a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Suspensión"@es .
etul:Direccion a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Dirección"@es .
etul:PuertasServicio a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Puertas de servicio"@es .
etul:Carroceria a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Carrocería"@es .
etul:SistemaCombustible a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Sistema de combustible"@es .
etul:Climatizacion a owl:NamedIndividual , etul:TipoComponente ;
    rdfs:label "Climatización"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:Motor etul:Transmision etul:Frenos etul:SistemaNeumatico etul:Neumaticos etul:SistemaElectrico etul:Suspension etul:Direccion etul:PuertasServicio etul:Carroceria etul:SistemaCombustible etul:Climatizacion ) .

etul:EstadoOperativo a owl:Class ;
    rdfs:label "Estado operativo"@es ;
    rdfs:comment "Estado de disponibilidad de un vehículo."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:Operativo etul:EnTaller etul:EsperandoRepuesto etul:FueraDeServicio etul:DocumentoVencido ) ] .

etul:Operativo a owl:NamedIndividual , etul:EstadoOperativo ;
    rdfs:label "Operativo"@es .
etul:EnTaller a owl:NamedIndividual , etul:EstadoOperativo ;
    rdfs:label "En taller"@es .
etul:EsperandoRepuesto a owl:NamedIndividual , etul:EstadoOperativo ;
    rdfs:label "Esperando repuesto"@es .
etul:FueraDeServicio a owl:NamedIndividual , etul:EstadoOperativo ;
    rdfs:label "Fuera de servicio"@es .
etul:DocumentoVencido a owl:NamedIndividual , etul:EstadoOperativo ;
    rdfs:label "Retenido por documento vencido"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:Operativo etul:EnTaller etul:EsperandoRepuesto etul:FueraDeServicio etul:DocumentoVencido ) .

etul:EstadoOrden a owl:Class ;
    rdfs:label "Estado de orden"@es ;
    rdfs:comment "Etapa del ciclo de vida de una orden de trabajo."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:Programada etul:EnEjecucion etul:BloqueadaPorRepuesto etul:Cerrada etul:Cancelada ) ] .

etul:Programada a owl:NamedIndividual , etul:EstadoOrden ;
    rdfs:label "Programada"@es .
etul:EnEjecucion a owl:NamedIndividual , etul:EstadoOrden ;
    rdfs:label "En ejecución"@es .
etul:BloqueadaPorRepuesto a owl:NamedIndividual , etul:EstadoOrden ;
    rdfs:label "Bloqueada por repuesto"@es .
etul:Cerrada a owl:NamedIndividual , etul:EstadoOrden ;
    rdfs:label "Cerrada"@es .
etul:Cancelada a owl:NamedIndividual , etul:EstadoOrden ;
    rdfs:label "Cancelada"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:Programada etul:EnEjecucion etul:BloqueadaPorRepuesto etul:Cerrada etul:Cancelada ) .

etul:Especialidad a owl:Class ;
    rdfs:label "Especialidad"@es ;
    rdfs:comment "Especialidad técnica requerida o dominada."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:EspMecanica etul:EspElectrica etul:EspNeumatica etul:EspFrenosSuspension etul:EspNeumaticos etul:EspCarroceria etul:EspGNV ) ] .

etul:EspMecanica a owl:NamedIndividual , etul:Especialidad ;
    rdfs:label "Mecánica general"@es .
etul:EspElectrica a owl:NamedIndividual , etul:Especialidad ;
    rdfs:label "Electricidad automotriz"@es .
etul:EspNeumatica a owl:NamedIndividual , etul:Especialidad ;
    rdfs:label "Sistemas neumáticos"@es .
etul:EspFrenosSuspension a owl:NamedIndividual , etul:Especialidad ;
    rdfs:label "Frenos y suspensión"@es .
etul:EspNeumaticos a owl:NamedIndividual , etul:Especialidad ;
    rdfs:label "Neumáticos"@es .
etul:EspCarroceria a owl:NamedIndividual , etul:Especialidad ;
    rdfs:label "Carrocería y planchado"@es .
etul:EspGNV a owl:NamedIndividual , etul:Especialidad ;
    rdfs:label "Sistemas de gas natural"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:EspMecanica etul:EspElectrica etul:EspNeumatica etul:EspFrenosSuspension etul:EspNeumaticos etul:EspCarroceria etul:EspGNV ) .

etul:Turno a owl:Class ;
    rdfs:label "Turno"@es ;
    rdfs:comment "Turno de trabajo u operación."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:TurnoManana etul:TurnoTarde etul:TurnoNoche ) ] .

etul:TurnoManana a owl:NamedIndividual , etul:Turno ;
    rdfs:label "Mañana"@es .
etul:TurnoTarde a owl:NamedIndividual , etul:Turno ;
    rdfs:label "Tarde"@es .
etul:TurnoNoche a owl:NamedIndividual , etul:Turno ;
    rdfs:label "Noche"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:TurnoManana etul:TurnoTarde etul:TurnoNoche ) .

etul:TipoLectura a owl:Class ;
    rdfs:label "Tipo de lectura"@es ;
    rdfs:comment "Instrumento de medición de uso."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:Odometro etul:Horometro ) ] .

etul:Odometro a owl:NamedIndividual , etul:TipoLectura ;
    rdfs:label "Odómetro (km)"@es .
etul:Horometro a owl:NamedIndividual , etul:TipoLectura ;
    rdfs:label "Horómetro (horas)"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:Odometro etul:Horometro ) .

etul:TipoDocumento a owl:Class ;
    rdfs:label "Tipo de documento"@es ;
    rdfs:comment "Documento con vigencia exigido para circular."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:SOAT etul:RevisionTecnica etul:AutorizacionRuta etul:CertificadoGNV etul:PolizaResponsabilidad ) ] .

etul:SOAT a owl:NamedIndividual , etul:TipoDocumento ;
    rdfs:label "SOAT"@es .
etul:RevisionTecnica a owl:NamedIndividual , etul:TipoDocumento ;
    rdfs:label "Revisión técnica vehicular"@es .
etul:AutorizacionRuta a owl:NamedIndividual , etul:TipoDocumento ;
    rdfs:label "Autorización de ruta"@es .
etul:CertificadoGNV a owl:NamedIndividual , etul:TipoDocumento ;
    rdfs:label "Certificado de conversión o inspección GNV"@es .
etul:PolizaResponsabilidad a owl:NamedIndividual , etul:TipoDocumento ;
    rdfs:label "Póliza de responsabilidad civil"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:SOAT etul:RevisionTecnica etul:AutorizacionRuta etul:CertificadoGNV etul:PolizaResponsabilidad ) .

etul:Severidad a owl:Class ;
    rdfs:label "Severidad"@es ;
    rdfs:comment "Gravedad de una falla."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:SeveridadBaja etul:SeveridadMedia etul:SeveridadAlta etul:SeveridadCritica ) ] .

etul:SeveridadBaja a owl:NamedIndividual , etul:Severidad ;
    rdfs:label "Baja"@es .
etul:SeveridadMedia a owl:NamedIndividual , etul:Severidad ;
    rdfs:label "Media"@es .
etul:SeveridadAlta a owl:NamedIndividual , etul:Severidad ;
    rdfs:label "Alta"@es .
etul:SeveridadCritica a owl:NamedIndividual , etul:Severidad ;
    rdfs:label "Crítica"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:SeveridadBaja etul:SeveridadMedia etul:SeveridadAlta etul:SeveridadCritica ) .

etul:TipoRegla a owl:Class ;
    rdfs:label "Tipo de regla"@es ;
    rdfs:comment "Clasificación del conocimiento experto según cómo lo usa el algoritmo."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:ReglaDura etul:ReglaPreferencia etul:ReglaPrioridad etul:ReglaHeuristica ) ] .

etul:ReglaDura a owl:NamedIndividual , etul:TipoRegla ;
    rdfs:label "Restricción dura"@es .
etul:ReglaPreferencia a owl:NamedIndividual , etul:TipoRegla ;
    rdfs:label "Preferencia"@es .
etul:ReglaPrioridad a owl:NamedIndividual , etul:TipoRegla ;
    rdfs:label "Regla de prioridad"@es .
etul:ReglaHeuristica a owl:NamedIndividual , etul:TipoRegla ;
    rdfs:label "Heurística"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:ReglaDura etul:ReglaPreferencia etul:ReglaPrioridad etul:ReglaHeuristica ) .

etul:EstadoValidacion a owl:Class ;
    rdfs:label "Estado de validación"@es ;
    rdfs:comment "Resultado de la validación de una regla con los expertos."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:Pendiente etul:Aprobada etul:Ajustar etul:Descartada ) ] .

etul:Pendiente a owl:NamedIndividual , etul:EstadoValidacion ;
    rdfs:label "Pendiente"@es .
etul:Aprobada a owl:NamedIndividual , etul:EstadoValidacion ;
    rdfs:label "Aprobada"@es .
etul:Ajustar a owl:NamedIndividual , etul:EstadoValidacion ;
    rdfs:label "Ajustar"@es .
etul:Descartada a owl:NamedIndividual , etul:EstadoValidacion ;
    rdfs:label "Descartada"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:Pendiente etul:Aprobada etul:Ajustar etul:Descartada ) .

etul:MotivoAjuste a owl:Class ;
    rdfs:label "Motivo de ajuste"@es ;
    rdfs:comment "Razón por la que se modificó la programación."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:MotivoRepuesto etul:MotivoTecnico etul:MotivoOperacion etul:MotivoFallaNueva etul:MotivoDocumento etul:MotivoCriterioExperto ) ] .

etul:MotivoRepuesto a owl:NamedIndividual , etul:MotivoAjuste ;
    rdfs:label "Falta de repuesto"@es .
etul:MotivoTecnico a owl:NamedIndividual , etul:MotivoAjuste ;
    rdfs:label "Técnico no disponible"@es .
etul:MotivoOperacion a owl:NamedIndividual , etul:MotivoAjuste ;
    rdfs:label "Necesidad de la operación o cobertura de ruta"@es .
etul:MotivoFallaNueva a owl:NamedIndividual , etul:MotivoAjuste ;
    rdfs:label "Falla nueva o urgencia"@es .
etul:MotivoDocumento a owl:NamedIndividual , etul:MotivoAjuste ;
    rdfs:label "Documento por vencer"@es .
etul:MotivoCriterioExperto a owl:NamedIndividual , etul:MotivoAjuste ;
    rdfs:label "Criterio del experto"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:MotivoRepuesto etul:MotivoTecnico etul:MotivoOperacion etul:MotivoFallaNueva etul:MotivoDocumento etul:MotivoCriterioExperto ) .

etul:RolExperto a owl:Class ;
    rdfs:label "Rol del experto"@es ;
    rdfs:comment "Rol de la persona entrevistada."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:RolJefeMantenimiento etul:RolProgramadorFlota etul:RolTecnicoSenior etul:RolJefeOperaciones etul:RolConductor ) ] .

etul:RolJefeMantenimiento a owl:NamedIndividual , etul:RolExperto ;
    rdfs:label "Jefe de mantenimiento"@es .
etul:RolProgramadorFlota a owl:NamedIndividual , etul:RolExperto ;
    rdfs:label "Programador de flota"@es .
etul:RolTecnicoSenior a owl:NamedIndividual , etul:RolExperto ;
    rdfs:label "Técnico senior"@es .
etul:RolJefeOperaciones a owl:NamedIndividual , etul:RolExperto ;
    rdfs:label "Jefe de operaciones"@es .
etul:RolConductor a owl:NamedIndividual , etul:RolExperto ;
    rdfs:label "Conductor"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:RolJefeMantenimiento etul:RolProgramadorFlota etul:RolTecnicoSenior etul:RolJefeOperaciones etul:RolConductor ) .

etul:TipoFuente a owl:Class ;
    rdfs:label "Tipo de fuente textual"@es ;
    rdfs:comment "Origen del texto del que se extraen hechos."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:ReporteConductor etul:ParteDiario etul:SesionChatbot etul:TextoOrdenTrabajo etul:TranscripcionEntrevista etul:ActaComite etul:ManualFabricante etul:ReporteIncidente ) ] .

etul:ReporteConductor a owl:NamedIndividual , etul:TipoFuente ;
    rdfs:label "Reporte de conductor"@es .
etul:ParteDiario a owl:NamedIndividual , etul:TipoFuente ;
    rdfs:label "Parte diario de operación"@es .
etul:SesionChatbot a owl:NamedIndividual , etul:TipoFuente ;
    rdfs:label "Sesión con el asistente de entrevista"@es .
etul:TextoOrdenTrabajo a owl:NamedIndividual , etul:TipoFuente ;
    rdfs:label "Texto libre de orden de trabajo"@es .
etul:TranscripcionEntrevista a owl:NamedIndividual , etul:TipoFuente ;
    rdfs:label "Transcripción de entrevista"@es .
etul:ActaComite a owl:NamedIndividual , etul:TipoFuente ;
    rdfs:label "Acta de comité"@es .
etul:ManualFabricante a owl:NamedIndividual , etul:TipoFuente ;
    rdfs:label "Manual del fabricante"@es .
etul:ReporteIncidente a owl:NamedIndividual , etul:TipoFuente ;
    rdfs:label "Reporte de incidente"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:ReporteConductor etul:ParteDiario etul:SesionChatbot etul:TextoOrdenTrabajo etul:TranscripcionEntrevista etul:ActaComite etul:ManualFabricante etul:ReporteIncidente ) .

etul:EstadoExtraccion a owl:Class ;
    rdfs:label "Estado de extracción"@es ;
    rdfs:comment "Resultado de la revisión humana sobre un hecho propuesto por el modelo."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:ExtPropuesta etul:ExtAceptada etul:ExtCorregida etul:ExtRechazada ) ] .

etul:ExtPropuesta a owl:NamedIndividual , etul:EstadoExtraccion ;
    rdfs:label "Propuesta"@es .
etul:ExtAceptada a owl:NamedIndividual , etul:EstadoExtraccion ;
    rdfs:label "Aceptada"@es .
etul:ExtCorregida a owl:NamedIndividual , etul:EstadoExtraccion ;
    rdfs:label "Aceptada con corrección"@es .
etul:ExtRechazada a owl:NamedIndividual , etul:EstadoExtraccion ;
    rdfs:label "Rechazada"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:ExtPropuesta etul:ExtAceptada etul:ExtCorregida etul:ExtRechazada ) .

etul:VeredictoEvaluacion a owl:Class ;
    rdfs:label "Veredicto de evaluación"@es ;
    rdfs:comment "Juicio humano sobre una respuesta generada."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:Correcta etul:ParcialmenteCorrecta etul:Incorrecta etul:SinRespuesta ) ] .

etul:Correcta a owl:NamedIndividual , etul:VeredictoEvaluacion ;
    rdfs:label "Correcta"@es .
etul:ParcialmenteCorrecta a owl:NamedIndividual , etul:VeredictoEvaluacion ;
    rdfs:label "Parcialmente correcta"@es .
etul:Incorrecta a owl:NamedIndividual , etul:VeredictoEvaluacion ;
    rdfs:label "Incorrecta"@es .
etul:SinRespuesta a owl:NamedIndividual , etul:VeredictoEvaluacion ;
    rdfs:label "El sistema no pudo responder"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:Correcta etul:ParcialmenteCorrecta etul:Incorrecta etul:SinRespuesta ) .

etul:TipoTarea a owl:Class ;
    rdfs:label "Tarea del modelo"@es ;
    rdfs:comment "Para qué se usó el modelo de lenguaje."@es ;
    rdfs:subClassOf etul:Catalogo ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( etul:TareaExtraccion etul:TareaTraduccion etul:TareaRedaccion ) ] .

etul:TareaExtraccion a owl:NamedIndividual , etul:TipoTarea ;
    rdfs:label "Extracción de hechos"@es .
etul:TareaTraduccion a owl:NamedIndividual , etul:TipoTarea ;
    rdfs:label "Traducción de pregunta a SPARQL"@es .
etul:TareaRedaccion a owl:NamedIndividual , etul:TipoTarea ;
    rdfs:label "Redacción de la respuesta"@es .

[] a owl:AllDifferent ;
    owl:distinctMembers ( etul:TareaExtraccion etul:TareaTraduccion etul:TareaRedaccion ) .

[] a owl:AllDisjointClasses ;
    owl:members ( etul:CategoriaVehiculo etul:TipoCombustible etul:TipoMantenimiento etul:TipoComponente etul:EstadoOperativo etul:EstadoOrden etul:Especialidad etul:Turno etul:TipoLectura etul:TipoDocumento etul:Severidad etul:TipoRegla etul:EstadoValidacion etul:MotivoAjuste etul:RolExperto etul:TipoFuente etul:EstadoExtraccion etul:VeredictoEvaluacion etul:TipoTarea ) .

# -----------------------------------------------------------------------------
# 3. Propiedades de objeto
# -----------------------------------------------------------------------------
etul:categoria a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "categoría"@es ;
    rdfs:comment "Categoría operativa del vehículo."@es ;
    rdfs:domain etul:Vehiculo ;
    rdfs:range etul:CategoriaVehiculo .

etul:combustible a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "combustible"@es ;
    rdfs:comment "Fuente de energía de la unidad."@es ;
    rdfs:domain etul:Vehiculo ;
    rdfs:range etul:TipoCombustible .

etul:asignadoATaller a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asignado a taller"@es ;
    rdfs:comment "Taller responsable del vehículo."@es ;
    rdfs:domain etul:Vehiculo ;
    rdfs:range etul:Taller .

etul:tienePlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tiene plan"@es ;
    rdfs:comment "Plan de mantenimiento vigente del vehículo."@es ;
    rdfs:domain etul:Vehiculo ;
    rdfs:range etul:PlanMantenimiento .

etul:estadoActual a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "estado actual"@es ;
    rdfs:comment "Estado operativo vigente del vehículo."@es ;
    rdfs:domain etul:Vehiculo ;
    rdfs:range etul:EstadoOperativo .

etul:rutaHabitual a owl:ObjectProperty ;
    rdfs:label "ruta habitual"@es ;
    rdfs:comment "Ruta en la que opera normalmente la unidad."@es ;
    rdfs:domain etul:Vehiculo ;
    rdfs:range etul:Ruta .

etul:rutaAutorizadaPara a owl:ObjectProperty ;
    rdfs:label "ruta autorizada para"@es ;
    rdfs:comment "Categorías de vehículo que pueden cubrir la ruta."@es ;
    rdfs:domain etul:Ruta ;
    rdfs:range etul:CategoriaVehiculo .

etul:asignacionDeVehiculo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asignación de vehículo"@es ;
    rdfs:comment "Vehículo asignado."@es ;
    rdfs:domain etul:AsignacionRuta ;
    rdfs:range etul:Vehiculo .

etul:tieneAsignacion a owl:ObjectProperty ;
    rdfs:label "tiene asignación"@es ;
    owl:inverseOf etul:asignacionDeVehiculo ;
    rdfs:domain etul:Vehiculo ;
    rdfs:range etul:AsignacionRuta .

etul:asignacionEnRuta a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asignación en ruta"@es ;
    rdfs:comment "Ruta cubierta."@es ;
    rdfs:domain etul:AsignacionRuta ;
    rdfs:range etul:Ruta .

etul:tieneAsignacionDeUnidad a owl:ObjectProperty ;
    rdfs:label "tiene asignación de unidad"@es ;
    owl:inverseOf etul:asignacionEnRuta ;
    rdfs:domain etul:Ruta ;
    rdfs:range etul:AsignacionRuta .

etul:asignacionAConductor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asignación a conductor"@es ;
    rdfs:comment "Conductor que opera la unidad."@es ;
    rdfs:domain etul:AsignacionRuta ;
    rdfs:range etul:Conductor .

etul:asignacionEnTurno a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asignación en turno"@es ;
    rdfs:comment "Turno de la asignación."@es ;
    rdfs:domain etul:AsignacionRuta ;
    rdfs:range etul:Turno .

etul:documentoDeVehiculo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "documento de vehículo"@es ;
    rdfs:comment "Vehículo al que pertenece el documento."@es ;
    rdfs:domain etul:DocumentoVehicular ;
    rdfs:range etul:Vehiculo .

etul:tieneDocumento a owl:ObjectProperty ;
    rdfs:label "tiene documento"@es ;
    owl:inverseOf etul:documentoDeVehiculo ;
    rdfs:domain etul:Vehiculo ;
    rdfs:range etul:DocumentoVehicular .

etul:tipoDocumento a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tipo de documento"@es ;
    rdfs:comment "Clase de documento."@es ;
    rdfs:domain etul:DocumentoVehicular ;
    rdfs:range etul:TipoDocumento .

etul:lecturaDeVehiculo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lectura de vehículo"@es ;
    rdfs:comment "Vehículo medido."@es ;
    rdfs:domain etul:Lectura ;
    rdfs:range etul:Vehiculo .

etul:tipoLectura a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tipo de lectura"@es ;
    rdfs:comment "Instrumento de la lectura."@es ;
    rdfs:domain etul:Lectura ;
    rdfs:range etul:TipoLectura .

etul:estadoDeVehiculo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "estado de vehículo"@es ;
    rdfs:comment "Vehículo al que corresponde el registro."@es ;
    rdfs:domain etul:RegistroEstado ;
    rdfs:range etul:Vehiculo .

etul:estadoRegistrado a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "estado registrado"@es ;
    rdfs:comment "Estado durante el periodo."@es ;
    rdfs:domain etul:RegistroEstado ;
    rdfs:range etul:EstadoOperativo .

etul:ordenRelacionada a owl:ObjectProperty ;
    rdfs:label "orden relacionada"@es ;
    rdfs:comment "Orden que originó el periodo, si aplica."@es ;
    rdfs:domain etul:RegistroEstado ;
    rdfs:range etul:OrdenTrabajo .

etul:planParaCategoria a owl:ObjectProperty ;
    rdfs:label "plan para categoría"@es ;
    rdfs:comment "Categorías a las que aplica el plan."@es ;
    rdfs:domain etul:PlanMantenimiento ;
    rdfs:range etul:CategoriaVehiculo .

etul:tareaDePlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tarea de plan"@es ;
    rdfs:comment "Plan al que pertenece la tarea."@es ;
    rdfs:domain etul:TareaProgramada ;
    rdfs:range etul:PlanMantenimiento .

etul:tieneTarea a owl:ObjectProperty ;
    rdfs:label "tiene tarea"@es ;
    owl:inverseOf etul:tareaDePlan ;
    rdfs:domain etul:PlanMantenimiento ;
    rdfs:range etul:TareaProgramada .

etul:tipoMantenimiento a owl:ObjectProperty ;
    rdfs:label "tipo de mantenimiento"@es ;
    rdfs:comment "Tipo de mantenimiento. Se usa en TareaProgramada, OrdenTrabajo y ReglaExperto."@es ;
    rdfs:range etul:TipoMantenimiento .

etul:tipoComponente a owl:ObjectProperty ;
    rdfs:label "tipo de componente"@es ;
    rdfs:comment "Componente involucrado. Se usa en TareaProgramada, OrdenTrabajo, Falla, Repuesto y ReglaExperto."@es ;
    rdfs:range etul:TipoComponente .

etul:aplicaACategoria a owl:ObjectProperty ;
    rdfs:label "aplica a categoría"@es ;
    rdfs:comment "Categorías de vehículo compatibles. Se usa en Bahia, Repuesto y ReglaExperto."@es ;
    rdfs:range etul:CategoriaVehiculo .

etul:requiereEspecialidad a owl:ObjectProperty ;
    rdfs:label "requiere especialidad"@es ;
    rdfs:comment "Especialidad técnica necesaria."@es ;
    rdfs:domain etul:TareaProgramada ;
    rdfs:range etul:Especialidad .

etul:ordenDeVehiculo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "orden de vehículo"@es ;
    rdfs:comment "Vehículo intervenido."@es ;
    rdfs:domain etul:OrdenTrabajo ;
    rdfs:range etul:Vehiculo .

etul:tieneOrden a owl:ObjectProperty ;
    rdfs:label "tiene orden"@es ;
    owl:inverseOf etul:ordenDeVehiculo ;
    rdfs:domain etul:Vehiculo ;
    rdfs:range etul:OrdenTrabajo .

etul:estadoOrden a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "estado de orden"@es ;
    rdfs:comment "Estado actual de la orden."@es ;
    rdfs:domain etul:OrdenTrabajo ;
    rdfs:range etul:EstadoOrden .

etul:asignadaATecnico a owl:ObjectProperty ;
    rdfs:label "asignada a técnico"@es ;
    rdfs:comment "Técnicos asignados."@es ;
    rdfs:domain etul:OrdenTrabajo ;
    rdfs:range etul:Tecnico .

etul:ejecutadaEnBahia a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ejecutada en bahía"@es ;
    rdfs:comment "Bahía asignada."@es ;
    rdfs:domain etul:OrdenTrabajo ;
    rdfs:range etul:Bahia .

etul:generadaPorTarea a owl:ObjectProperty ;
    rdfs:label "generada por tarea"@es ;
    rdfs:comment "Tarea del plan que originó la orden."@es ;
    rdfs:domain etul:OrdenTrabajo ;
    rdfs:range etul:TareaProgramada .

etul:originadaPorFalla a owl:ObjectProperty ;
    rdfs:label "originada por falla"@es ;
    rdfs:comment "Falla que originó la orden correctiva."@es ;
    rdfs:domain etul:OrdenTrabajo ;
    rdfs:range etul:Falla .

etul:consumoEnOrden a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "consumo en orden"@es ;
    rdfs:comment "Orden que requiere el repuesto."@es ;
    rdfs:domain etul:ConsumoRepuesto ;
    rdfs:range etul:OrdenTrabajo .

etul:tieneConsumo a owl:ObjectProperty ;
    rdfs:label "tiene consumo"@es ;
    owl:inverseOf etul:consumoEnOrden ;
    rdfs:domain etul:OrdenTrabajo ;
    rdfs:range etul:ConsumoRepuesto .

etul:repuestoConsumido a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "repuesto consumido"@es ;
    rdfs:comment "Repuesto requerido o utilizado."@es ;
    rdfs:domain etul:ConsumoRepuesto ;
    rdfs:range etul:Repuesto .

etul:fallaEnVehiculo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "falla en vehículo"@es ;
    rdfs:comment "Vehículo donde ocurrió la falla."@es ;
    rdfs:domain etul:Falla ;
    rdfs:range etul:Vehiculo .

etul:severidad a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "severidad"@es ;
    rdfs:comment "Gravedad de la falla."@es ;
    rdfs:domain etul:Falla ;
    rdfs:range etul:Severidad .

etul:reportadaPorConductor a owl:ObjectProperty ;
    rdfs:label "reportada por conductor"@es ;
    rdfs:comment "Conductor que reportó la falla."@es ;
    rdfs:domain etul:Falla ;
    rdfs:range etul:Conductor .

etul:fallaEnRuta a owl:ObjectProperty ;
    rdfs:label "falla en ruta"@es ;
    rdfs:comment "Ruta en la que se detectó la falla."@es ;
    rdfs:domain etul:Falla ;
    rdfs:range etul:Ruta .

etul:bahiaDeTaller a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "bahía de taller"@es ;
    rdfs:comment "Taller al que pertenece la bahía."@es ;
    rdfs:domain etul:Bahia ;
    rdfs:range etul:Taller .

etul:tieneEspecialidad a owl:ObjectProperty ;
    rdfs:label "tiene especialidad"@es ;
    rdfs:comment "Especialidades que domina el técnico."@es ;
    rdfs:domain etul:Tecnico ;
    rdfs:range etul:Especialidad .

etul:trabajaEnTurno a owl:ObjectProperty ;
    rdfs:label "trabaja en turno"@es ;
    rdfs:comment "Turnos asignados al técnico."@es ;
    rdfs:domain etul:Tecnico ;
    rdfs:range etul:Turno .

etul:tecnicoDeTaller a owl:ObjectProperty ;
    rdfs:label "técnico de taller"@es ;
    rdfs:comment "Taller donde trabaja el técnico."@es ;
    rdfs:domain etul:Tecnico ;
    rdfs:range etul:Taller .

etul:conductorHabilitadoEn a owl:ObjectProperty ;
    rdfs:label "habilitado en ruta"@es ;
    rdfs:comment "Rutas que el conductor está autorizado a operar."@es ;
    rdfs:domain etul:Conductor ;
    rdfs:range etul:Ruta .

etul:rolExperto a owl:ObjectProperty ;
    rdfs:label "rol del experto"@es ;
    rdfs:comment "Rol de la persona entrevistada."@es ;
    rdfs:domain etul:Experto ;
    rdfs:range etul:RolExperto .

etul:entrevistado a owl:ObjectProperty ;
    rdfs:label "entrevistado"@es ;
    rdfs:comment "Expertos que participaron en la sesión."@es ;
    rdfs:domain etul:SesionEntrevista ;
    rdfs:range etul:Experto .

etul:tipoRegla a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tipo de regla"@es ;
    rdfs:comment "Clasificación de la regla."@es ;
    rdfs:domain etul:ReglaExperto ;
    rdfs:range etul:TipoRegla .

etul:estadoValidacion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "estado de validación"@es ;
    rdfs:comment "Resultado de la validación."@es ;
    rdfs:domain etul:ReglaExperto ;
    rdfs:range etul:EstadoValidacion .

etul:fuenteExperto a owl:ObjectProperty ;
    rdfs:label "fuente experto"@es ;
    rdfs:comment "Experto que expresó la regla."@es ;
    rdfs:domain etul:ReglaExperto ;
    rdfs:range etul:Experto .

etul:capturadaEnSesion a owl:ObjectProperty ;
    rdfs:label "capturada en sesión"@es ;
    rdfs:comment "Sesión donde se capturó."@es ;
    rdfs:domain etul:ReglaExperto ;
    rdfs:range etul:SesionEntrevista .

etul:validadaPor a owl:ObjectProperty ;
    rdfs:label "validada por"@es ;
    rdfs:comment "Experto que validó la regla."@es ;
    rdfs:domain etul:ReglaExperto ;
    rdfs:range etul:Experto .

etul:aplicaARuta a owl:ObjectProperty ;
    rdfs:label "aplica a ruta"@es ;
    rdfs:comment "Rutas a las que se limita la regla."@es ;
    rdfs:domain etul:ReglaExperto ;
    rdfs:range etul:Ruta .

etul:ajusteDeOrden a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ajuste de orden"@es ;
    rdfs:comment "Orden reprogramada."@es ;
    rdfs:domain etul:AjusteCalendario ;
    rdfs:range etul:OrdenTrabajo .

etul:motivoAjuste a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "motivo de ajuste"@es ;
    rdfs:comment "Motivo del cambio."@es ;
    rdfs:domain etul:AjusteCalendario ;
    rdfs:range etul:MotivoAjuste .

etul:realizadoPor a owl:ObjectProperty ;
    rdfs:label "realizado por"@es ;
    rdfs:comment "Persona que hizo el ajuste."@es ;
    rdfs:domain etul:AjusteCalendario ;
    rdfs:range etul:Persona .

etul:reglaCandidata a owl:ObjectProperty ;
    rdfs:label "regla candidata"@es ;
    rdfs:comment "Regla que explica o formaliza el ajuste."@es ;
    rdfs:domain etul:AjusteCalendario ;
    rdfs:range etul:ReglaExperto .

etul:tareaDelModelo a owl:ObjectProperty ;
    rdfs:label "tarea del modelo"@es ;
    rdfs:comment "Para qué se usa el modelo en el experimento."@es ;
    rdfs:domain etul:ModeloLLM ;
    rdfs:range etul:TipoTarea .

etul:tipoFuente a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tipo de fuente"@es ;
    rdfs:comment "Origen del texto."@es ;
    rdfs:domain etul:FuenteTextual ;
    rdfs:range etul:TipoFuente .

etul:fuenteSobreVehiculo a owl:ObjectProperty ;
    rdfs:label "fuente sobre vehículo"@es ;
    rdfs:comment "Vehículo al que se refiere el texto, si aplica."@es ;
    rdfs:domain etul:FuenteTextual ;
    rdfs:range etul:Vehiculo .

etul:fuenteRedactadaPor a owl:ObjectProperty ;
    rdfs:label "redactada por"@es ;
    rdfs:comment "Persona que produjo el texto."@es ;
    rdfs:domain etul:FuenteTextual ;
    rdfs:range etul:Persona .

etul:fuenteDeSesion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transcripción de sesión"@es ;
    rdfs:comment "Sesión de entrevista transcrita, si aplica."@es ;
    rdfs:domain etul:FuenteTextual ;
    rdfs:range etul:SesionEntrevista .

etul:derivadaDeFuente a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "derivada de fuente"@es ;
    rdfs:comment "Fuente textual de la que se extrajo el hecho."@es ;
    rdfs:domain etul:ExtraccionLLM ;
    rdfs:range etul:FuenteTextual .

etul:generoExtraccion a owl:ObjectProperty ;
    rdfs:label "generó extracción"@es ;
    owl:inverseOf etul:derivadaDeFuente ;
    rdfs:domain etul:FuenteTextual ;
    rdfs:range etul:ExtraccionLLM .

etul:generadaPorModelo a owl:ObjectProperty ;
    rdfs:label "generada por modelo"@es ;
    rdfs:comment "Modelo de lenguaje que produjo el resultado. Se usa en ExtraccionLLM, ConsultaNL y RespuestaGenerada."@es ;
    rdfs:range etul:ModeloLLM .

etul:estadoExtraccion a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "estado de extracción"@es ;
    rdfs:comment "Resultado de la revisión humana."@es ;
    rdfs:domain etul:ExtraccionLLM ;
    rdfs:range etul:EstadoExtraccion .

etul:revisadaPor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "revisada por"@es ;
    rdfs:comment "Persona que revisó el hecho propuesto."@es ;
    rdfs:domain etul:ExtraccionLLM ;
    rdfs:range etul:Persona .

etul:materializadaEn a owl:ObjectProperty ;
    rdfs:label "materializada en"@es ;
    rdfs:comment "Individuo del grafo que se creó o actualizó a partir del hecho aceptado."@es ;
    rdfs:domain etul:ExtraccionLLM ;
    rdfs:range owl:Thing .

etul:respondePreguntaDe a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reformulación de"@es ;
    rdfs:comment "Consulta previa que esta reformula, si hubo varios intentos."@es ;
    rdfs:domain etul:ConsultaNL ;
    rdfs:range etul:ConsultaNL .

etul:respondeConsulta a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responde consulta"@es ;
    rdfs:comment "Consulta que originó la respuesta."@es ;
    rdfs:domain etul:RespuestaGenerada ;
    rdfs:range etul:ConsultaNL .

etul:tieneRespuesta a owl:ObjectProperty ;
    rdfs:label "tiene respuesta"@es ;
    owl:inverseOf etul:respondeConsulta ;
    rdfs:domain etul:ConsultaNL ;
    rdfs:range etul:RespuestaGenerada .

etul:fundamentadaEn a owl:ObjectProperty ;
    rdfs:label "fundamentada en"@es ;
    rdfs:comment "Individuos del grafo citados como evidencia de la respuesta."@es ;
    rdfs:domain etul:RespuestaGenerada ;
    rdfs:range owl:Thing .

etul:evaluaRespuesta a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "evalúa respuesta"@es ;
    rdfs:comment "Respuesta evaluada."@es ;
    rdfs:domain etul:EvaluacionRespuesta ;
    rdfs:range etul:RespuestaGenerada .

etul:tieneEvaluacion a owl:ObjectProperty ;
    rdfs:label "tiene evaluación"@es ;
    owl:inverseOf etul:evaluaRespuesta ;
    rdfs:domain etul:RespuestaGenerada ;
    rdfs:range etul:EvaluacionRespuesta .

etul:veredicto a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "veredicto"@es ;
    rdfs:comment "Juicio del evaluador."@es ;
    rdfs:domain etul:EvaluacionRespuesta ;
    rdfs:range etul:VeredictoEvaluacion .

etul:evaluadaPor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "evaluada por"@es ;
    rdfs:comment "Persona que evaluó la respuesta."@es ;
    rdfs:domain etul:EvaluacionRespuesta ;
    rdfs:range etul:Persona .

