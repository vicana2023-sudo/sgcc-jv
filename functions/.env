# Qué agente atiende. Se cambia aquí y se vuelve a desplegar; no se toca código.
#
#   vertex-gemini     Gemini en Vertex AI       autentica por IAM, sin clave
#   vertex-anthropic  Claude en Vertex AI       autentica por IAM, sin clave
#   anthropic         API directa de Anthropic  requiere ANTHROPIC_API_KEY
#
# Por defecto Google, porque el proyecto ya vive en GCP: la función se
# autentica con su propia cuenta de servicio y no hay ninguna clave que
# guardar, rotar ni filtrar.
AGENTE_PROVEEDOR=vertex-gemini

# Vacío = el que proveedores.js trae por defecto para ese proveedor.
# Existe para poder subir de versión de modelo sin desplegar código nuevo.
AGENTE_MODELO=gemini-2.0-flash

AGENTE_REGION=us-central1
